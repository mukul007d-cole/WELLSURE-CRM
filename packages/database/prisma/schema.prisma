generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum DataScope {
  SELF
  TEAM
  DEPARTMENT
  ORGANIZATION
}

enum FieldAccessLevel {
  VIEW
  EDIT
}

enum OutcomeType {
  open
  closed_won
  closed_lost
}

enum BehaviorType {
  default
  call_later
  follow_up
  archived
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments         Department[]
  designations        Designation[]
  roles               Role[]
  users               User[]
  journeys            Journey[]
  services            Service[]
  statuses            Status[]
  fields              Field[]
  leads               Lead[]
  auditLogs           SystemAuditLog[]
  importJobs          ImportJob[]
  importJobRows       ImportJobRow[]
  payments            Payment[]
  notifications       Notification[]
  notificationRules   NotificationRule[]
  campaigns           Campaign[]
  campaignSends       CampaignSend[]
  teams               Team[]
  routingRules        StatusRoutingRule[]
  routingPermissions  StatusRoutingPermission[]
  settings            Setting[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts       FailedLoginAttempt[]

  @@map("organizations")
}

model Department {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("DepartmentCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?        @relation("DepartmentUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  users        User[]
  teams        Team[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("departments")
}

model Designation {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("DesignationCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?        @relation("DesignationUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  users        User[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("designations")
}

model Role {
  id              String   @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  key             String
  name            String
  active          Boolean  @default(true)
  version         Int      @default(1)
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  createdById     String?  @map("created_by") @db.Uuid
  updatedById     String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User?                     @relation("RoleCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy       User?                     @relation("RoleUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  users           User[]
  permissions     RolePermission[]
  journeyAccess   RoleJourneyAccess[]
  fieldVisibility FieldVisibility[]
  routingGrants   StatusRoutingPermission[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("roles")
}

model User {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String
  roleId         String   @map("role_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  designationId  String?  @map("designation_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  active         Boolean  @default(true)
  passwordHash   String?  @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                     Role                      @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  department               Department?               @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  designation              Designation?              @relation(fields: [organizationId, designationId], references: [organizationId, id], onDelete: Restrict)
  manager                  User?                     @relation("ReportingHierarchy", fields: [organizationId, managerId], references: [organizationId, id], onDelete: Restrict)
  reports                  User[]                    @relation("ReportingHierarchy")
  assignments              Assignment[]
  grants                   UserAccessGrant[]         @relation("GrantRecipient")
  issuedGrants             UserAccessGrant[]         @relation("GrantIssuer")
  notifications            Notification[]
  deactivatedLeads         Lead[]                    @relation("LeadDeactivatedBy")
  notificationRulesCreated NotificationRule[]        @relation("NotificationRuleCreatedBy")
  notificationRulesUpdated NotificationRule[]        @relation("NotificationRuleUpdatedBy")
  departmentsCreated       Department[]              @relation("DepartmentCreatedBy")
  departmentsUpdated       Department[]              @relation("DepartmentUpdatedBy")
  designationsCreated      Designation[]             @relation("DesignationCreatedBy")
  designationsUpdated      Designation[]             @relation("DesignationUpdatedBy")
  rolesCreated             Role[]                    @relation("RoleCreatedBy")
  rolesUpdated             Role[]                    @relation("RoleUpdatedBy")
  journeysCreated          Journey[]                 @relation("JourneyCreatedBy")
  journeysUpdated          Journey[]                 @relation("JourneyUpdatedBy")
  servicesCreated          Service[]                 @relation("ServiceCreatedBy")
  servicesUpdated          Service[]                 @relation("ServiceUpdatedBy")
  statusesCreated          Status[]                  @relation("StatusCreatedBy")
  statusesUpdated          Status[]                  @relation("StatusUpdatedBy")
  fieldsCreated            Field[]                   @relation("FieldCreatedBy")
  fieldsUpdated            Field[]                   @relation("FieldUpdatedBy")
  activities               ActivityLog[]
  auditLogs                SystemAuditLog[]
  assignedTasks            Task[]
  uploadedAttachments      Attachment[]
  importJobs               ImportJob[]
  settingsUpdated          Setting[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  campaignsCreated         Campaign[]                @relation("CampaignCreatedBy")
  campaignsUpdated         Campaign[]                @relation("CampaignUpdatedBy")
  teamsCreated             Team[]                    @relation("TeamCreatedBy")
  teamsUpdated             Team[]                    @relation("TeamUpdatedBy")
  teamMemberships          TeamMember[]
  routingRulesCreated      StatusRoutingRule[]       @relation("RoutingRuleCreatedBy")
  routingRulesUpdated      StatusRoutingRule[]       @relation("RoutingRuleUpdatedBy")
  routingCursorFor         StatusRoutingRule[]       @relation("RoutingCursor")
  routingPoolMemberships   StatusRoutingRuleMember[]

  @@id([organizationId, id])
  @@unique([organizationId, email])
  // Referenced by the `team_members` foreign key that makes "a member belongs
  // to the team's Department" a database constraint rather than a check the
  // application has to remember on every path. See ADR-0014 and the
  // `00000000000005_teams` migration.
  @@unique([organizationId, departmentId, id])
  @@index([organizationId, managerId])
  @@index([organizationId, departmentId])
  @@map("users")
}

model Session {
  id             String    @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, tokenHash])
  @@index([organizationId, userId, revokedAt, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id             String    @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, tokenHash])
  @@index([organizationId, userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model FailedLoginAttempt {
  id              String    @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  normalizedEmail String    @map("normalized_email")
  failedCount     Int       @default(0) @map("failed_count")
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, normalizedEmail])
  @@index([organizationId, lockedUntil])
  @@map("failed_login_attempts")
}

model RolePermission {
  id             String    @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  module         String
  action         String
  scope          DataScope
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role Role @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, roleId, module, action])
  @@index([organizationId, module, action])
  @@map("role_permissions")
}

model Journey {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  active         Boolean  @default(true)
  version        Int      @default(1)
  isDefault      Boolean  @default(false) @map("is_default")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("JourneyCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy        User?                 @relation("JourneyUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  statuses         Status[]
  processInstances ProcessInstance[]
  roleAccess       RoleJourneyAccess[]
  fieldSettings    FieldJourneySetting[]
  journeyServices  JourneyService[]
  campaigns        Campaign[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("journeys")
}

model RoleJourneyAccess {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  journeyId      String   @map("journey_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role    Role    @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  journey Journey @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, roleId, journeyId])
  @@index([organizationId, journeyId, roleId])
  @@map("role_journey_access")
}

model Service {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("ServiceCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy       User?            @relation("ServiceUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  journeyServices JourneyService[]
  leadServices    LeadService[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@map("services")
}

model JourneyService {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  journeyId      String   @map("journey_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  journey Journey @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)
  service Service @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, journeyId, serviceId])
  @@map("journey_services")
}

model Status {
  id                String       @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  journeyId         String       @map("journey_id") @db.Uuid
  key               String
  name              String
  active            Boolean      @default(true)
  version           Int          @default(1)
  isDefaultOnCreate Boolean      @default(false) @map("is_default_on_create")
  outcomeType       OutcomeType  @map("outcome_type")
  behaviorType      BehaviorType @map("behavior_type")
  sortOrder         Int          @map("sort_order")
  createdById       String?      @map("created_by") @db.Uuid
  updatedById       String?      @map("updated_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User?                     @relation("StatusCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy          User?                     @relation("StatusUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  journey            Journey                   @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)
  processInstances   ProcessInstance[]
  requiredSettings   FieldJourneySetting[]
  createdTasks       Task[]
  campaigns          Campaign[]
  /// At most one, guaranteed by the unique constraint on the rule rather than
  /// by a one-to-one relation that would need a second redundant index.
  routingRules       StatusRoutingRule[]
  routingPermissions StatusRoutingPermission[]

  @@id([organizationId, id])
  @@unique([organizationId, journeyId, key])
  @@unique([organizationId, journeyId, id])
  @@index([organizationId, journeyId, active, sortOrder])
  @@map("statuses")
}

model Field {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  fieldType      String   @map("field_type")
  validationRule Json?    @map("validation_rule") @db.JsonB
  section        String?
  editMode       String   @map("edit_mode")
  source         String
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("FieldCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?                 @relation("FieldUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  settings     FieldJourneySetting[]
  visibility   FieldVisibility[]
  attachments  Attachment[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, active])
  @@map("fields")
}

model FieldJourneySetting {
  id                   String   @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  fieldId              String   @map("field_id") @db.Uuid
  journeyId            String   @map("journey_id") @db.Uuid
  requirement          String
  requiredFromStatusId String?  @map("required_from_status_id") @db.Uuid
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  field              Field   @relation(fields: [organizationId, fieldId], references: [organizationId, id], onDelete: Restrict)
  journey            Journey @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)
  requiredFromStatus Status? @relation(fields: [organizationId, journeyId, requiredFromStatusId], references: [organizationId, journeyId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, fieldId, journeyId])
  @@map("field_journey_settings")
}

model FieldVisibility {
  id             String           @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  fieldId        String           @map("field_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  accessLevel    FieldAccessLevel @map("access_level")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  field Field @relation(fields: [organizationId, fieldId], references: [organizationId, id], onDelete: Restrict)
  role  Role  @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, fieldId, roleId])
  @@index([organizationId, roleId, accessLevel])
  @@map("field_visibility")
}

model Lead {
  id                  String    @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  name                String
  phone               String?
  email               String?
  fieldValues         Json      @default("{}") @map("field_values") @db.JsonB
  active              Boolean   @default(true)
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId String?   @map("deactivated_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deactivatedBy    User?             @relation("LeadDeactivatedBy", fields: [organizationId, deactivatedByUserId], references: [organizationId, id], onDelete: Restrict)
  processInstances ProcessInstance[]
  grants           UserAccessGrant[]
  activities       ActivityLog[]
  tasks            Task[]
  attachments      Attachment[]
  invoices         Invoice[]
  payments         Payment[]
  notifications    Notification[]
  linksFrom        LeadLink[]        @relation("LeadLinkFrom")
  linksTo          LeadLink[]        @relation("LeadLinkTo")
  campaignSends    CampaignSend[]
  importedByRows   ImportJobRow[]    @relation("ImportJobRowLead")
  matchedByRows    ImportJobRow[]    @relation("ImportJobRowMatchedLead")

  @@id([organizationId, id])
  @@index([organizationId, active, updatedAt])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, updatedAt])
  @@map("leads")
}

model ProcessInstance {
  id              String   @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  journeyId       String   @map("journey_id") @db.Uuid
  currentStatusId String   @map("current_status_id") @db.Uuid
  isPrimary       Boolean  @default(false) @map("is_primary")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead          Lead          @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)
  journey       Journey       @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)
  currentStatus Status        @relation(fields: [organizationId, journeyId, currentStatusId], references: [organizationId, journeyId, id], onDelete: Restrict)
  assignments    Assignment[]
  leadServices   LeadService[]
  activities     ActivityLog[]
  tasks          Task[]
  importJobRows  ImportJobRow[]

  @@id([organizationId, id])
  @@index([organizationId, journeyId, currentStatusId])
  @@index([organizationId, leadId])
  @@map("process_instances")
}

model Assignment {
  id                String   @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  processInstanceId String   @map("process_instance_id") @db.Uuid
  assignmentType    String   @map("assignment_type")
  userId            String   @map("user_id") @db.Uuid
  assignedAt        DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  isCurrent         Boolean  @default(true) @map("is_current")

  processInstance ProcessInstance @relation(fields: [organizationId, processInstanceId], references: [organizationId, id], onDelete: Restrict)
  user            User            @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@index([organizationId, userId, isCurrent])
  @@map("assignments")
}

model LeadService {
  id                String    @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  processInstanceId String    @map("process_instance_id") @db.Uuid
  serviceId         String    @map("service_id") @db.Uuid
  active            Boolean   @default(true)
  enrolledAt        DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  endedAt           DateTime? @map("ended_at") @db.Timestamptz(6)

  processInstance ProcessInstance @relation(fields: [organizationId, processInstanceId], references: [organizationId, id], onDelete: Restrict)
  service         Service         @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, processInstanceId, serviceId])
  @@map("lead_services")
}

model LeadLink {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadIdA        String   @map("lead_id_a") @db.Uuid
  leadIdB        String   @map("lead_id_b") @db.Uuid
  relationType   String   @map("relation_type")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  leadA Lead @relation("LeadLinkFrom", fields: [organizationId, leadIdA], references: [organizationId, id], onDelete: Restrict)
  leadB Lead @relation("LeadLinkTo", fields: [organizationId, leadIdB], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, leadIdA, leadIdB, relationType])
  @@map("lead_links")
}

