/// A marketing email sent to Leads, not a notification sent to Users. The two
/// share trigger detection and nothing else.
model Campaign {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  subject        String
  /// Closed-vocabulary document; the server renders and escapes the HTML at
  /// send time so no client markup is ever stored or re-emitted.
  bodyDocument   Json     @default("{\"blocks\":[]}") @map("body_document") @db.JsonB
  /// manual | triggered
  type           String
  /// Manual campaigns only: a stored Phase 13b filter, evaluated at send time.
  filter         Json?    @db.JsonB
  /// Triggered campaigns only: exact-match Journey/Status pair (ADR-0001).
  journeyId      String?  @map("journey_id") @db.Uuid
  statusId       String?  @map("status_id") @db.Uuid
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String   @map("created_by") @db.Uuid
  updatedById    String   @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("CampaignCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User           @relation("CampaignUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  journey      Journey?       @relation(fields: [organizationId, journeyId], references: [organizationId, id], onDelete: Restrict)
  status       Status?        @relation(fields: [organizationId, statusId], references: [organizationId, id], onDelete: Restrict)
  sends        CampaignSend[]

  @@id([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, type, active, journeyId, statusId])
  @@map("campaigns")
}

/// One row per (campaign, lead): the sent-count stat and the idempotency record.
model CampaignSend {
  id             String    @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  /// pending | sent | failed | skipped_no_email
  status         String    @default("pending")
  error          String?
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  campaign     Campaign     @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict)
  lead         Lead         @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, campaignId, leadId])
  @@index([organizationId, status, createdAt])
  @@map("campaign_sends")
}

/// A named group of Users inside one Department, with one or more leaders.
///
/// Deliberately NOT the same thing as the `TEAM` data scope, which resolves
/// through `users.manager_id` and is untouched by this model. See ADR-0014.
model Team {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  key            String
  name           String
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department          @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User?               @relation("TeamCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?               @relation("TeamUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  members      TeamMember[]
  routingRules StatusRoutingRule[]

  @@id([organizationId, id])
  @@unique([organizationId, departmentId, key])
  /// Referenced by `team_members`' department-enforcing foreign key.
  @@unique([organizationId, departmentId, id])
  @@index([organizationId, departmentId, active])
  @@map("teams")
}

/// Membership of one User in one Team. `isLeader` marks a Team Leader, so a
/// leader is structurally also a member and there is no second source of truth.
///
/// `departmentId` is denormalized so the database — not just the service layer
/// — enforces that a member belongs to the Team's Department.
model TeamMember {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  isLeader       Boolean  @default(false) @map("is_leader")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  user User @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, teamId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, teamId, isLeader])
  @@map("team_members")
}

/// How leads entering one Status are automatically assigned.
///
/// At most one rule per Status, enforced by a unique constraint rather than by
/// application code. Fires on exact status entry only, per ADR-0001. See
/// ADR-0015.
model StatusRoutingRule {
  id             String  @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  journeyId      String  @map("journey_id") @db.Uuid
  statusId       String  @map("status_id") @db.Uuid
  /// Which assignment slot the rule writes. Free text, like every other
  /// assignment_type in this system — never a closed enum.
  assignmentType String  @map("assignment_type")
  /// round_robin | least_loaded
  algorithm      String
  /// team | users
  poolType       String  @map("pool_type")
  teamId         String? @map("team_id") @db.Uuid

  /// Durable round-robin state: the user last assigned by this rule, not an
  /// index. An index breaks whenever the pool changes size; this survives it.
  cursorUserId String? @map("cursor_user_id") @db.Uuid

  active      Boolean  @default(true)
  version     Int      @default(1)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status       Status                    @relation(fields: [organizationId, journeyId, statusId], references: [organizationId, journeyId, id], onDelete: Restrict)
  team         Team?                     @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  cursorUser   User?                     @relation("RoutingCursor", fields: [organizationId, cursorUserId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User?                     @relation("RoutingRuleCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  updatedBy    User?                     @relation("RoutingRuleUpdatedBy", fields: [organizationId, updatedById], references: [organizationId, id], onDelete: Restrict)
  members      StatusRoutingRuleMember[]

  @@id([organizationId, id])
  @@unique([organizationId, statusId])
  @@index([organizationId, statusId, active])
  @@map("status_routing_rules")
}

/// One candidate in a `pool_type = 'users'` rule. Team pools read `team_members`
/// instead, so a Team's membership stays the single source of truth.
model StatusRoutingRuleMember {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rule StatusRoutingRule @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Restrict)
  user User              @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, ruleId, userId])
  @@map("status_routing_rule_members")
}

/// Per-(Status, Role) routing grant, allow-list semantics: no row means denied.
///
/// The same shape `field_visibility` has for Fields, and layered the same way —
/// the effective decision is the `lead_routing` module action AND a row here.
/// Editing these rows is gated on `roles_permissions:edit`, never on
/// `lead_routing:configure`, so a routing administrator cannot grant themselves
/// routing rights.
model StatusRoutingPermission {
  id             String   @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  statusId       String   @map("status_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  /// view | configure | operate
  action         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status       Status       @relation(fields: [organizationId, statusId], references: [organizationId, id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, statusId, roleId, action])
  @@index([organizationId, roleId, action])
  @@map("status_routing_permissions")
}
