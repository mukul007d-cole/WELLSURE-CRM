{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build", "^lint"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["FALCON_POSTGRES_URL", "DOCKER_HOST"]
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
