# Copy to terraform.tfvars (gitignored) and fill in. The procedure, step by
# step, is docs/operations/production-deployment.md.
environment = "production"
aws_region  = "ap-south-1"

# Placeholder until the service exists; the guide's phase 10 replaces it with
# App Runner's URL, or with the custom domain once one is attached.
public_base_url = "https://placeholder.invalid"

# Must be on a domain verified with the email provider. Password resets and
# campaigns should not share a sending subdomain — see ADR-0018.
email_from          = "Falcon CRM <no-reply@notify.example.com>"
campaign_email_from = "Falcon Campaigns <news@mail.example.com>"

# The git SHA of an image already pushed to ECR. The placeholder is fine until
# the guide's phase 9, when App Runner is created from it.
image_tag = "<git sha of a pushed image>"

# Database decisions. These are the recommended values; the guide prices them.
db_instance_class        = "db.t4g.micro"
db_multi_az              = true
db_backup_retention_days = 14

common_tags = {
  Owner = "platform"
}

# No secret belongs in this file. The database password is generated by
# Terraform; the email API key is entered once, by hand, into Secrets Manager.
