# Local development defaults. Copy to `.env`; never reuse these anywhere real.
# Every variable is documented in docs/operations/environment-variables.md.

# --- Local infrastructure (docker compose) -----------------------------------
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=falcon_local_only
POSTGRES_PORT=5432

# --- Database ----------------------------------------------------------------
# DATABASE_URL is read by the Prisma CLI; FALCON_DATABASE_URL by the API.
DATABASE_URL=postgresql://falcon:falcon_local_only@localhost:5432/falcon?schema=public
FALCON_DATABASE_URL=postgresql://falcon:falcon_local_only@localhost:5432/falcon?schema=public
TEST_DATABASE_URL=postgresql://falcon:falcon_local_only@localhost:5432/falcon_test?schema=public

# --- API ---------------------------------------------------------------------
FALCON_HTTP_PORT=3000
FALCON_CORS_ORIGIN=http://localhost:5173
FALCON_LOG_LEVEL=info
# false locally because the dev server is plain http. Always true when deployed.
FALCON_SESSION_COOKIE_SECURE=false

# --- Email -------------------------------------------------------------------
# `console` prints the reset token and a copy-pasteable curl to the terminal
# instead of sending mail. Treat that output as a credential. A deployed
# environment must never use it: stdout there is the log stream.
FALCON_EMAIL_TRANSPORT=console
# Required only when FALCON_EMAIL_TRANSPORT is not `console`. Left blank so a
# local checkout keeps working with no provider account.
FALCON_EMAIL_API_KEY=
FALCON_EMAIL_FROM=
# Optional campaign sender. Falls back to FALCON_EMAIL_FROM when unset; use a
# separately verified sending subdomain in deployed environments.
FALCON_CAMPAIGN_EMAIL_FROM=
# Public origin of the deployed app, used for the password-reset link in mail.
# Required only when a real transport is selected.
FALCON_PUBLIC_BASE_URL=

# --- Web ---------------------------------------------------------------------
# Substituted into the bundle at build time. V1 is single-tenant, so this is the
# one fixed organization; replace it with the UUID the bootstrap CLI prints.
VITE_FALCON_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# Set only in a deployed environment, where the API serves the built bundle
# same-origin. Locally Vite serves the app and proxies /api, so leave it unset.
FALCON_WEB_ROOT=

# --- Object storage (optional; ADR-0012) --------------------------------------
# All five or none. Without them the API still boots and the document locker
# answers 503 rather than failing at upload time.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=falcon_local
MINIO_ROOT_PASSWORD=falcon_local_only_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=falcon-local
S3_ACCESS_KEY=falcon_local
S3_SECRET_KEY=falcon_local_only_password

# --- Redis (started by docker compose; nothing reads it yet) ------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
